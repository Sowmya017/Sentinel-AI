# ─────────────────────────────────────────────
#  Sentinel-AI Backend — Environment Variables
# ─────────────────────────────────────────────

# ── Groq ──────────────────────────────────────
# Get your key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# ── Hindsight ─────────────────────────────────
# Hindsight Cloud (confirmed): https://api.hindsight.vectorize.io
# Self-hosted Docker:           http://localhost:8888
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=hsk_your_hindsight_api_key_here

# ── Hindsight Memory Bank ─────────────────────
# A single bank namespace for all Sentinel-AI memories
HINDSIGHT_BANK_ID=sentinel-ai

# ── Server ────────────────────────────────────
PORT=3001

# ── CORS ──────────────────────────────────────
# Comma-separated list of allowed frontend origins
# e.g.  http://localhost:5173,https://sentinel-ai.example.com
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
